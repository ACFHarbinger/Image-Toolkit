{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capability/auth.json",
  "title": "AuthCapability",
  "description": "Report that the webview session stays locked (#918). Does not open the vault.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "AuthStatusParams": {
      "title": "AuthStatusParams",
      "type": "object",
      "additionalProperties": false,
      "required": ["account"],
      "properties": {
        "account": { "type": "string", "minLength": 1 }
      }
    },
    "AuthStatusResult": {
      "title": "AuthStatusResult",
      "type": "object",
      "additionalProperties": false,
      "required": ["unlocked", "account", "reason"],
      "properties": {
        "unlocked": { "type": "boolean", "const": false },
        "account": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "const": "unlock stays on the C++ session" }
      }
    }
  }
}
