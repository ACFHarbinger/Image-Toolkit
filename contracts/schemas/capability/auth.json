{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capability/auth.json",
  "title": "AuthCapability",
  "description": "C++ vault session owned by the sidecar process (#1106). The password is a request parameter only and is never returned.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "AuthStatusParams": {
      "title": "AuthStatusParams",
      "type": "object",
      "additionalProperties": false,
      "required": ["account"],
      "properties": {
        "account": { "type": "string", "minLength": 1 }
      }
    },
    "AuthStatusResult": {
      "title": "AuthStatusResult",
      "type": "object",
      "additionalProperties": false,
      "required": ["unlocked", "account", "reason"],
      "properties": {
        "unlocked": { "type": "boolean" },
        "account": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "AuthUnlockParams": {
      "title": "AuthUnlockParams",
      "type": "object",
      "additionalProperties": false,
      "required": ["account", "password"],
      "properties": {
        "account": { "type": "string", "minLength": 1 },
        "password": { "type": "string", "minLength": 1 }
      }
    },
    "AuthUnlockResult": {
      "title": "AuthUnlockResult",
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "account", "message"],
      "properties": {
        "success": { "type": "boolean" },
        "account": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "profiles": {
          "description": "Names of the saved system preference profiles. Present on success.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "credentials": {
          "description": "Names of the API credential files loaded into the vault. Never their contents.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "AuthLockParams": {
      "title": "AuthLockParams",
      "type": "object",
      "additionalProperties": false,
      "required": ["account"],
      "properties": {
        "account": { "type": "string", "minLength": 1 }
      }
    },
    "AuthLockResult": {
      "title": "AuthLockResult",
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "account"],
      "properties": {
        "success": { "type": "boolean" },
        "account": { "type": "string", "minLength": 1 }
      }
    },
    "AuthGuestParams": {
      "title": "AuthGuestParams",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "username": {
          "description": "Guest name. Empty or absent makes an anonymous guest_xxxxxxxx account.",
          "type": ["string", "null"]
        }
      }
    },
    "AuthGuestResult": {
      "title": "AuthGuestResult",
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "account", "anonymous", "message"],
      "properties": {
        "success": { "type": "boolean" },
        "account": { "type": "string", "minLength": 1 },
        "anonymous": { "type": "boolean" },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "AuthApplyProfileParams": {
      "title": "AuthApplyProfileParams",
      "type": "object",
      "additionalProperties": false,
      "required": ["account", "profile"],
      "properties": {
        "account": { "type": "string", "minLength": 1 },
        "profile": {
          "description": "Default, Previous Profile, or the name of a saved profile.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "AuthApplyProfileResult": {
      "title": "AuthApplyProfileResult",
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "account", "profile", "message", "theme", "tab_configurations"],
      "properties": {
        "success": { "type": "boolean" },
        "account": { "type": "string", "minLength": 1 },
        "profile": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "theme": { "type": "string", "enum": ["dark", "light"] },
        "tab_configurations": { "type": "object", "additionalProperties": true }
      }
    }
  }
}
