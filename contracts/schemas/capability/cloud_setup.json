{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capability/cloud_setup.json",
  "title": "CloudSetupCapability",
  "description": "Cloud Compute setup window data (T-04 / #920): the provider descriptor catalog. Credentials never transit the bridge: provider account setup writes only non-secret config through the settings capability, and attaching real credentials rides the vault unlock (#918 / #879).",
  "type": "object",
  "$defs": {
    "CloudSetupEmptyParams": {
      "title": "CloudSetupEmptyParams",
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "ProviderDescriptor": {
      "title": "ProviderDescriptor",
      "description": "One provider card; the Qt providers pane's descriptor with badge_color as a theme-token name.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "name",
        "badge_text",
        "badge_token",
        "description",
        "target_service",
        "cpu_shapes",
        "memory_tiers",
        "gpu_options",
        "cost_estimate",
        "cold_start",
        "regions",
        "is_poc_target"
      ],
      "properties": {
        "provider_id": { "type": "string", "enum": ["gcd", "cloudflare", "oracle", "aws"] },
        "name": { "type": "string", "minLength": 1 },
        "badge_text": { "type": "string" },
        "badge_token": { "type": "string" },
        "description": { "type": "string" },
        "target_service": { "type": "string" },
        "cpu_shapes": { "type": "string" },
        "memory_tiers": { "type": "string" },
        "gpu_options": { "type": "string" },
        "cost_estimate": { "type": "string" },
        "cold_start": { "type": "string" },
        "regions": { "type": "array", "items": { "type": "string" } },
        "config_file": { "type": "string" },
        "is_poc_target": { "type": "boolean" }
      }
    },
    "ProvidersResult": {
      "title": "ProvidersResult",
      "type": "object",
      "additionalProperties": false,
      "required": ["providers"],
      "properties": {
        "providers": { "type": "array", "items": { "$ref": "#/$defs/ProviderDescriptor" } }
      }
    }
  }
}
