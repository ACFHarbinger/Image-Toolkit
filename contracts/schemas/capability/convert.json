{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capability/convert.json",
  "title": "ConvertCapability",
  "description": "Image conversion for the Convert pilot (#894). Quality is fixed at the canonical converter value (95); any other value is rejected.",
  "type": "object",
  "$defs": {
    "ConvertParams": {
      "title": "ConvertParams",
      "type": "object",
      "additionalProperties": false,
      "required": ["input_path", "output_path"],
      "properties": {
        "input_path": { "type": "string", "minLength": 1 },
        "output_path": { "type": "string", "minLength": 1 },
        "output_format": { "type": "string", "minLength": 1 },
        "quality": { "const": 95 },
        "overwrite": { "type": "boolean" }
      }
    },
    "ConvertResult": {
      "title": "ConvertResult",
      "type": "object",
      "additionalProperties": false,
      "required": ["input_path", "output_path", "success"],
      "properties": {
        "input_path": { "type": "string" },
        "output_path": { "type": "string" },
        "success": { "type": "boolean" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "elapsed_seconds": { "type": "number", "minimum": 0 },
        "error": { "type": ["string", "null"] }
      }
    },
    "ConvertBatchParams": {
      "title": "ConvertBatchParams",
      "type": "object",
      "additionalProperties": false,
      "required": ["input_dir", "output_dir"],
      "properties": {
        "input_dir": { "type": "string", "minLength": 1 },
        "output_dir": { "type": "string", "minLength": 1 },
        "output_format": { "type": "string", "minLength": 1 },
        "input_formats": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "quality": { "const": 95 },
        "recursive": { "type": "boolean" },
        "overwrite": { "type": "boolean" },
        "paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "action": { "type": "string", "enum": ["convert", "resample", "reencode"] },
        "width": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "height": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "algorithm": { "type": "string", "enum": ["nearest", "bilinear", "bicubic", "lanczos"] },
        "video_codec": { "type": "string", "enum": ["h264", "hevc", "av1", "vp9", "copy"] },
        "audio_codec": { "type": "string", "enum": ["aac", "opus", "mp3", "flac", "copy"] },
        "crf": { "type": "integer", "minimum": 0, "maximum": 63 }
      }
    },
    "ConvertBatchResult": {
      "title": "ConvertBatchResult",
      "type": "object",
      "additionalProperties": false,
      "description": "Accepted batch. Counts and paths are on jobs.status result when the job reaches a terminal state.",
      "required": ["job_id"],
      "properties": {
        "job_id": { "type": "string", "minLength": 1 }
      }
    },
    "ConvertListDirParams": {
      "title": "ConvertListDirParams",
      "type": "object",
      "additionalProperties": false,
      "required": ["directory"],
      "properties": {
        "directory": { "type": "string", "minLength": 1 }
      }
    },
    "ConvertListDirResult": {
      "title": "ConvertListDirResult",
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "error"],
      "properties": {
        "files": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "error": { "type": "string" }
      }
    }
  }
}
