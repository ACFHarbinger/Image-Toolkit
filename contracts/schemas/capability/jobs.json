{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capability/jobs.json",
  "title": "JobsCapability",
  "description": "Durable-job surface shared by local services and the Cloud Jobs daemon (one protocol, Kimi proposal section 7). `spec` is opaque at the bridge layer: the owning service validates it, so job kinds can evolve without bridge changes. Cancel is idempotent (roadmap: one idempotent job.cancel).",
  "type": "object",
  "$defs": {
    "JobState": {
      "title": "JobState",
      "enum": [
        "queued",
        "provisioning",
        "running",
        "cancelling",
        "collecting",
        "settling",
        "completed",
        "failed",
        "cancelled",
        "capped"
      ]
    },
    "JobProgress": {
      "title": "JobProgress",
      "type": "object",
      "additionalProperties": false,
      "required": ["done", "total"],
      "properties": {
        "done": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "SubmitParams": {
      "title": "SubmitParams",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "spec"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "spec": { "type": "object" }
      }
    },
    "SubmitResult": {
      "title": "SubmitResult",
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id"],
      "properties": {
        "job_id": { "type": "string", "minLength": 1 }
      }
    },
    "CancelParams": {
      "title": "CancelParams",
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id"],
      "properties": {
        "job_id": { "type": "string", "minLength": 1 }
      }
    },
    "CancelResult": {
      "title": "CancelResult",
      "type": "object",
      "additionalProperties": false,
      "required": ["ok"],
      "properties": {
        "ok": { "const": true }
      }
    },
    "StatusParams": {
      "title": "StatusParams",
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id"],
      "properties": {
        "job_id": { "type": "string", "minLength": 1 }
      }
    },
    "JobStatus": {
      "title": "JobStatus",
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "kind", "state"],
      "properties": {
        "job_id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "state": { "$ref": "#/$defs/JobState" },
        "progress": { "$ref": "#/$defs/JobProgress" },
        "error": { "$ref": "../envelope/error.json" }
      }
    },
    "ListParams": {
      "title": "ListParams",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "states": {
          "type": "array",
          "items": { "$ref": "#/$defs/JobState" },
          "uniqueItems": true
        },
        "limit": { "type": "integer", "minimum": 1, "maximum": 500 }
      }
    },
    "ListResult": {
      "title": "ListResult",
      "type": "object",
      "additionalProperties": false,
      "required": ["jobs"],
      "properties": {
        "jobs": { "type": "array", "items": { "$ref": "#/$defs/JobStatus" } }
      }
    },
    "JobListSnapshot": {
      "title": "JobListSnapshot",
      "type": "object",
      "additionalProperties": false,
      "required": ["jobs"],
      "properties": {
        "jobs": { "type": "array", "items": { "$ref": "#/$defs/JobStatus" } }
      }
    },
    "JobEventPayload": {
      "title": "JobEventPayload",
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "state"],
      "properties": {
        "job_id": { "type": "string", "minLength": 1 },
        "state": { "$ref": "#/$defs/JobState" },
        "progress": { "$ref": "#/$defs/JobProgress" }
      }
    }
  }
}
