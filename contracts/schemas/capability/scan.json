{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capability/scan.json",
  "title": "ScanCapability",
  "description": "Library directory scanning and metadata tagging capability (L-04 #898). Gate B compliant: does not open cloud_jobs.db or unsealed stores directly.",
  "type": "object",
  "$defs": {
    "ScannedImage": {
      "title": "ScannedImage",
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "filename", "extension", "size_bytes", "in_database"],
      "properties": {
        "path": { "type": "string" },
        "filename": { "type": "string" },
        "extension": { "type": "string" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "width": { "type": ["integer", "null"], "minimum": 0 },
        "height": { "type": ["integer", "null"], "minimum": 0 },
        "in_database": { "type": "boolean" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "group_name": { "type": ["string", "null"] },
        "subgroup_name": { "type": ["string", "null"] }
      }
    },
    "ScanDirectoryParams": {
      "title": "ScanDirectoryParams",
      "type": "object",
      "additionalProperties": false,
      "required": ["directory"],
      "properties": {
        "directory": { "type": "string", "minLength": 1 },
        "recursive": { "type": "boolean" },
        "formats": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "max_results": { "type": "integer", "minimum": 1, "maximum": 50000 }
      }
    },
    "ScanDirectoryResult": {
      "title": "ScanDirectoryResult",
      "type": "object",
      "additionalProperties": false,
      "required": ["directory", "total_found", "images", "database_available"],
      "properties": {
        "directory": { "type": "string" },
        "total_found": { "type": "integer", "minimum": 0 },
        "images": {
          "type": "array",
          "items": { "$ref": "#/$defs/ScannedImage" }
        },
        "database_available": { "type": "boolean" }
      }
    },
    "SaveMetadataItem": {
      "title": "SaveMetadataItem",
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "group_name": { "type": ["string", "null"] },
        "subgroup_name": { "type": ["string", "null"] }
      }
    },
    "SaveMetadataParams": {
      "title": "SaveMetadataParams",
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/SaveMetadataItem" }
        }
      }
    },
    "SaveMetadataResult": {
      "title": "SaveMetadataResult",
      "type": "object",
      "additionalProperties": false,
      "required": ["saved_count", "success", "database_available"],
      "properties": {
        "saved_count": { "type": "integer", "minimum": 0 },
        "success": { "type": "boolean" },
        "database_available": { "type": "boolean" },
        "errors": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "SuggestTagsParams": {
      "title": "SuggestTagsParams",
      "type": "object",
      "additionalProperties": false,
      "required": ["paths"],
      "properties": {
        "paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "SuggestTagsResult": {
      "title": "SuggestTagsResult",
      "type": "object",
      "additionalProperties": false,
      "required": ["suggestions"],
      "properties": {
        "suggestions": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
