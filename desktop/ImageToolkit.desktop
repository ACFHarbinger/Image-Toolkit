#!/usr/bin/env xdg-open
[Desktop Entry]
Name=Image Toolkit
Comment=Image database and edit toolkit
Exec=Image-Toolkit/dist/ImageToolkitApp # <--- Full path to the executable!
Icon=Image-Toolkit/assets/images/ImageToolkit.png # <--- Full path to the icon file!
Terminal=false
Type=Application
Categories=Utility;Graphics;
# Must match QApplication.setDesktopFileName("ImageToolkit") in backend/src/app.py
# so X11 (WM_CLASS) and Wayland (app_id) group every window/tray surface into
# one taskbar entry instead of spawning a second icon in background mode.
StartupWMClass=ImageToolkit