{
  "schema": "devtool.plugin.manifest",
  "schema_version": 1,
  "name": "semantic_security",
  "version": "0.1.0",
  "description": "Research-only static candidate findings; not a CPG/CodeQL engine or v1 scanner.",
  "surfaces": [{"name": "cli", "description": "Auditable candidate findings"}],
  "channels": [{"key": "source_candidates", "label": "Static candidate findings", "default_enabled": true, "retention": "forever"}],
  "entry": {"python_module": "tool.plugins.semantic_security:plugin", "command": [".venv/bin/python", "dev", "plugin-run", "semantic_security"]}
}
