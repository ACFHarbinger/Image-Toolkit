{
  "name": "image-toolkit-docs-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "React documentation portal and visual engineering hub for Image-Toolkit.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "data:m0": "python3 scripts/generate_m0_data.py",
    "gen:theme-tokens": "python ../../tools/dev/theming/export_css_tokens.py --surface docs --out src/styles/theme-tokens.generated.css",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "aurelia": "^2.0.0-beta.26",
    "framer-motion": "^13.3.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.18.7",
    "lucide-react": "^1.46.0",
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^12.0.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-react": "^6.0.5",
    "astro": "^7.3.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "js-yaml": "^5.4.2",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.28",
    "storybook": "^10.5.7",
    "tailwindcss": "^4.3.3",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^5.7.2",
    "vite": "^8.2.1",
    "vitest": "^5.0.1"
  }
