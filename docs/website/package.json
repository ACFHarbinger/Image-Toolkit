{
  "name": "image-toolkit-docs-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vue documentation portal for Image-Toolkit, rendering docs/**/*.md.",
  "scripts": {
    "prebuild": "node scripts/generate-nav.mjs",
    "predev": "node scripts/generate-nav.mjs",
    "dev": "vite",
    "build": "vue-tsc -b --noCheck && vite build && node scripts/spa-fallback.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^5.2.0",
    "markdown-it": "^15.0.0",
    "markdown-it-anchor": "^9.2.0",
    "highlight.js": "^11.11.1",
    "mermaid": "^11.4.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "js-yaml": "^5.2.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vue-tsc": "^3.3.9"
  }
}
