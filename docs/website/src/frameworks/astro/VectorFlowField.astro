---
/**
 * VectorFlowField — Astro island visualizing approximate-nearest-neighbor
 * search over a scattered 2D embedding projection, illustrating what the
 * pgvector-backed similarity search (backend/src/database/image_database.py)
 * conceptually does without shipping the real ML pipeline: query points
 * find their k nearest neighbors by Euclidean distance and draw connecting
 * edges, colored by distance (closer = warmer).
 */
interface Props {
  /** Deterministic seed for layout (stable static export). */
  seed?: number;
  /** Number of scattered "embedding" points. */
  pointCount?: number;
  /** Number of query points that search for neighbors. */
  queryCount?: number;
  /** Neighbors per query (k in k-NN). */
  k?: number;
  /** Accessible title. */
  title?: string;
  /** Optional subtitle shown under the title. */
  subtitle?: string;
}

const {
  seed = 2024,
  pointCount = 140,
  queryCount = 5,
  k = 6,
  title = "Vector flow field",
  subtitle = "Query points (◆) finding their k nearest neighbors across a scattered embedding projection (illustrative — not live pgvector data)",
} = Astro.props;

/** Mulberry32 — tiny seeded PRNG for build-time determinism. */
function mulberry32(a: number) {
  return function next() {
    let t = (a += 0x6d2b79f5);
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = mulberry32(seed);
const width = 720;
const height = 380;
const pad = 24;

type Point = { x: number; y: number };

const points: Point[] = Array.from({ length: pointCount }, () => ({
  x: pad + rand() * (width - pad * 2),
  y: pad + rand() * (height - pad * 2),
}));

const queries: Point[] = Array.from({ length: queryCount }, () => ({
  x: pad + rand() * (width - pad * 2),
  y: pad + rand() * (height - pad * 2),
}));

function squaredDistance(a: Point, b: Point): number {
  return (a.x - b.x) ** 2 + (a.y - b.y) ** 2;
}

type Edge = { from: Point; to: Point; dist: number; rank: number };

const edges: Edge[] = queries.flatMap((q) => {
  const ranked = points
    .map((p) => ({ p, dist: Math.sqrt(squaredDistance(q, p)) }))
    .sort((a, b) => a.dist - b.dist)
    .slice(0, k);
  const maxDist = ranked[ranked.length - 1]?.dist || 1;
  return ranked.map((r, i) => ({ from: q, to: r.p, dist: r.dist / maxDist, rank: i }));
});

function edgeColor(distNorm: number): string {
  // Warmer (closer) -> cooler (farther), interpolated in HSL.
  const hue = 265 - distNorm * 100; // violet (close) -> cyan (far)
  return `hsl(${hue}, 80%, 62%)`;
}
---

<div class="vff-root">
  <header>
    <p class="kicker">Framework island · Astro</p>
    <h2>{title}</h2>
    <p class="subtitle">{subtitle}</p>
  </header>
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={title}>
    {
      edges.map((e) => (
        <line
          x1={e.from.x}
          y1={e.from.y}
          x2={e.to.x}
          y2={e.to.y}
          stroke={edgeColor(e.dist)}
          stroke-width={e.rank === 0 ? 1.6 : 0.8}
          stroke-opacity={0.75 - e.rank * 0.06}
        />
      ))
    }
    {points.map((p) => <circle cx={p.x} cy={p.y} r="2.4" class="point" />)}
    {
      queries.map((q) => (
        <path
          transform={`translate(${q.x}, ${q.y})`}
          d="M0,-7 L7,0 L0,7 L-7,0 Z"
          class="query"
        />
      ))
    }
  </svg>
  <p class="legend">
    <span class="legend-item"><span class="swatch query-swatch" /> query point</span>
    <span class="legend-item"><span class="swatch point-swatch" /> embedding</span>
    <span class="legend-item"><span class="swatch edge-swatch" /> nearest-neighbor edge (violet = closer)</span>
  </p>
</div>

<style>
  .vff-root {
    font-family:
      Inter,
      system-ui,
      -apple-system,
      sans-serif;
    color: #191324;
    padding: 0.25rem;
  }
  :global(html[data-theme="dark"]) .vff-root,
  .vff-root.dark {
    color: #f1edfb;
  }
  header {
    margin-bottom: 0.5rem;
  }
  .kicker {
    margin: 0 0 0.2rem;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.65;
  }
  h2 {
    margin: 0 0 0.35rem;
    font-size: 1.15rem;
  }
  .subtitle {
    margin: 0 0 0.6rem;
    font-size: 0.82rem;
    opacity: 0.75;
    max-width: 42rem;
  }
  svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .point {
    fill: currentColor;
    opacity: 0.35;
  }
  .query {
    fill: #7c3aed;
    stroke: #fff;
    stroke-width: 1;
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 0.6rem 0 0;
    font-size: 0.72rem;
    opacity: 0.75;
  }
  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .swatch {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 2px;
    display: inline-block;
  }
  .query-swatch {
    background: #7c3aed;
  }
  .point-swatch {
    background: currentColor;
    opacity: 0.5;
  }
  .edge-swatch {
    background: linear-gradient(90deg, #7c3aed, #22d3ee);
  }
</style>
