QDialog {
    background: $DARK_SECONDARY_BG;
    color: $DARK_TEXT;
}
QLabel {
    color: $DARK_ACCENT_COLOR;
    font-weight: bold;
    font-size: 12px;
}
QListWidget {
    background: $DARK_BG;
    border: 1px solid $DARK_BORDER;
    border-radius: 6px;
    color: $DARK_TEXT;
}
QListWidget::item:hover {
    background: $DARK_ACCENT_COLOR;
    color: black;
}
QComboBox {
    background: $DARK_BG;
    color: $DARK_TEXT;
    border: 1px solid $DARK_BORDER;
    border-radius: 4px;
    padding: 4px;
}
QTabWidget::pane {
    border: 1px solid $DARK_BORDER;
    background: $DARK_SECONDARY_BG;
    border-radius: 6px;
}
QTabBar::tab {
    background: $DARK_BG;
    color: $DARK_MUTED_TEXT;
    padding: 8px 16px;
    border: 1px solid $DARK_BORDER;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}
QTabBar::tab:selected {
    background: $DARK_SECONDARY_BG;
    color: $DARK_ACCENT_COLOR;
    border-bottom-color: $DARK_SECONDARY_BG;
    font-weight: bold;
}
