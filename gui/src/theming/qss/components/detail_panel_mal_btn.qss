QPushButton {
    background-color: #1565c0;
    color: white;
    font-weight: bold;
    padding: 6px 8px;
    border-radius: 6px;
    border: none;
}
QPushButton:hover {
    background-color: #1976d2;
}
QPushButton:pressed {
    background-color: #0d47a1;
}
QPushButton:disabled {
    background-color: #37474f;
    color: #78909c;
}
