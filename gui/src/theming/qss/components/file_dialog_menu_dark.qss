QMenu {
    background-color: $DARK_SECONDARY_BG;
    color: $DARK_TEXT;
    border: 1px solid $DARK_BORDER;
    font-family: 'Inter', 'Segoe UI', Arial, sans-serif;
    font-size: 12px;
}
QMenu::item {
    padding: 6px 20px;
}
QMenu::item:selected {
    background-color: $DARK_ACCENT_COLOR;
    color: black;
}
QMenu::separator {
    height: 1px;
    background-color: $DARK_BORDER;
    margin: 4px 0px;
}
