QPushButton {
    font-size: 40px;
    font-weight: bold;
    color: rgba(255, 255, 255, 0.9);
    background: rgba(30, 33, 36, 0.3);
    border: none;
    padding: 10px;
    margin: 0 10px;
}
QPushButton:hover {
    background: rgba(30, 33, 36, 0.7);
    color: $DARK_ACCENT_COLOR;
}
QPushButton:disabled {
    color: rgba(255, 255, 255, 0.2);
    background: transparent;
}
