{
  "name": "image-toolkit-root",
  "version": "1.0.0",
  "description": "Root package for the Image Toolkit repo.",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "frontend",
    "docs/website"
  ],
  "scripts": {
    "install:all": "npm install && npm install --workspace=frontend && npm install --workspace=docs/website",
    "setup": "npm run install:all && npm install --save-dev @types/react-dom",
    "dev": "npm run tauri:dev",
    "build": "npm run tauri:build",
    "tauri:dev": "npm run tauri dev --workspace=frontend",
    "tauri:build": "npm run tauri build --workspace=frontend",
    "tauri:check": "cd frontend/src-tauri && cargo check",
    "start-frontend": "npm run start --workspace=frontend",
    "build-frontend": "npm run build --workspace=frontend",
    "test-frontend": "npm run test --workspace=frontend",
    "test": "npm run test-frontend",
    "docs-website:dev": "npm run dev --workspace=docs/website",
    "docs-website:build": "npm run build --workspace=docs/website",
    "docs-website:preview": "npm run preview --workspace=docs/website"
  },
  "devDependencies": {
    "@types/react-dom": "^19.3.0"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "underscore": "1.13.8",
    "qs": "6.16.0"
  }
}
