# tools/test — run the test suites.
#
# Module recipes execute with cwd = this file's directory (`tools/test/`),
# not the repo root (CSG #58). `cd` into each package so `uv run` sees that
# package's pyproject.toml instead of walking up to Image-Toolkit.

set shell := ["bash", "-c"]

all: src gui

src:
    cd ../../logic && uv run pytest test -q

gui:
    cd ../../gui && uv run pytest test -q
