{
  "name": "hie-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Hybrid Image Editor web/Tauri frontend and embeddable React tab",
  "exports": {
    ".": "./src/main.ts",
    "./host": "./src/host.ts",
    "./embed/react": "./src/embed/react/index.ts",
    "./embed/react/HieEditorTab": "./src/embed/react/HieEditorTab.tsx",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "index.html",
    "src-tauri",
    "tsconfig.json"
  ],
  "scripts": {
