  },
  "peerDependenciesMeta": {
    "lucide-react": { "optional": true },
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.4.3"
  }
