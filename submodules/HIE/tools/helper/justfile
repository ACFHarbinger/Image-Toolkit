# tools/helper — presentation + project stats.

set shell := ["bash", "-c"]

bold := '\033[1m'
cyan := '\033[0;36m'
reset := '\033[0m'

# Print the project banner
[private]
_print_header:
    @printf '{{bold}}{{cyan}}Hybrid-Image-Editor (HIE){{reset}}\n'
    @printf 'C++ Repository Template (C++17 · CMake · GTest · Google Benchmark)\n\n'

# List every recipe across all sub-modules
help: _print_header
    @just --list --list-submodules

# Show project statistics
stats: _print_header
    @echo "Lines of code:"; tokei || true
