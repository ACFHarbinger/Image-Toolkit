# tools/benchmark/justfile
# Performance benchmarks (Image-Toolkit) + ASP quality/eval recipes.
#
# ASP components live under middleware/benchmark/asp and middleware/src/stitching (W0-03 #867/#1039).

set shell := ["bash", "-c"]
set unstable := true
set working-directory := '../..'

# Image-Toolkit root (this file is tools/benchmark/justfile)
_IT_ROOT := justfile_directory()
_ASP_BENCH := _IT_ROOT / "middleware" / "benchmark" / "asp"
_ASP_CLI := _IT_ROOT / "middleware" / "src" / "stitching" / "cli"
_IT_PY := _IT_ROOT / ".venv" / "bin" / "python"
# Deterministic defaults pin the benchmark RNGs and CUDA kernels; caller
# overrides are preserved. #654 found the RAW_ASP set could churn on identical
# input/config. Three re-runs of the same flaky cases matched exactly with
# deterministic mode, seed 42, and CUBLAS_WORKSPACE_CONFIG=:4096:8.
_ASP_ENV := "PYTHONPATH='" + _IT_ROOT + "' " + \
    "ASP_DETERMINISTIC=\"${ASP_DETERMINISTIC:-1}\" " + \
    "ASP_REPRO_SEED=\"${ASP_REPRO_SEED:-42}\" " + \
    "PYTHONHASHSEED=\"${PYTHONHASHSEED:-42}\" " + \
    "CUBLAS_WORKSPACE_CONFIG=\"${CUBLAS_WORKSPACE_CONFIG:-:4096:8}\""

# Run benchmarks
benchmark:
    @echo "🏃 Running benchmarks..."
    source .venv/bin/activate && python middleware/benchmark/run_all.py
    just test-base-cpp

# Run benchmarks and save detailed reports
benchmark-save:
    @echo "🏃 Running benchmarks with detailed reporting..."
    source .venv/bin/activate && python middleware/benchmark/run_all.py --save --report
    @echo "✅ Benchmark reports saved to middleware/benchmark/results/"

# Launch benchmark analysis dashboard
benchmark-dashboard:
    @echo "📊 Launching Benchmark Dashboard..."
    @echo "Dashboard will open at http://localhost:8501"
    source .venv/bin/activate && streamlit run middleware/ui/benchmark_dashboard.py

# Aggregate ASP automated runs + human ratings into docs/website/public/data/
# for the ratings dashboard (/dashboard/ratings).
dashboard-data:
    @echo "📦 Generating docs website dashboard JSON..."
    node docs/website/scripts/generate-dashboard-data.mjs

# --- ASP quality benchmark (middleware/benchmark/asp) ---

# Full corpus run.
asp-benchmark *ARGS:
    @echo "🎞️  Running ASP benchmark on all datasets..."
    {{_ASP_ENV}} {{_IT_PY}} \
        {{_ASP_BENCH}}/bench_anime_stitch.py --data-dir data/asp/dump {{ARGS}}
    @echo "✅ ASP benchmark complete."

# Run ASP benchmark on specific named datasets.
# Usage: just asp-benchmark-tests asp_test09 asp_test27 asp_test57
asp-benchmark-tests *tests:
    @echo "🎞️  Running ASP benchmark on: {{tests}}"
    {{_ASP_ENV}} {{_IT_PY}} \
        {{_ASP_BENCH}}/bench_anime_stitch.py --data-dir data/asp/dump --tests {{tests}}

# Run ASP benchmark on a numeric range of datasets.
# Usage: just asp-benchmark-range 1-10
# Usage: just asp-benchmark-range 4,8,27,57
asp-benchmark-range range:
    @echo "🎞️  Running ASP benchmark on range: {{range}}"
    {{_ASP_ENV}} {{_IT_PY}} \
        {{_ASP_BENCH}}/bench_anime_stitch.py --data-dir data/asp/dump --range "{{range}}"

# Run ASP benchmark on the first N datasets.
# Usage: just asp-benchmark-first 5
asp-benchmark-first n="5":
    @echo "🎞️  Running ASP benchmark on first {{n}} datasets..."
    {{_ASP_ENV}} {{_IT_PY}} \
        {{_ASP_BENCH}}/bench_anime_stitch.py --data-dir data/asp/dump --first {{n}}

# Run ASP benchmark only on datasets not yet processed (panorama.png absent).
asp-benchmark-resume:
    @echo "🎞️  Resuming ASP benchmark (skipping already-processed datasets)..."
    {{_ASP_ENV}} {{_IT_PY}} \
        {{_ASP_BENCH}}/bench_anime_stitch.py --data-dir data/asp/dump --skip-done

# Run ASP benchmark on the standard quality-verification test suite:
# test09 (canonical seam-tear), test27 (full-body portrait), test08 (high-motion),
# test57 (comparable), test04 (gate fallback).
asp-benchmark-verify:
    @echo "🎞️  Running ASP quality-verification suite (5 tests)..."
    {{_ASP_ENV}} {{_IT_PY}} \
        {{_ASP_BENCH}}/bench_anime_stitch.py --data-dir data/asp/dump \
        --tests asp_test04 asp_test08 asp_test09 asp_test27 asp_test57
    @echo "✅ Verification complete. Check .agent/cache/pipeline_analysis_report.md"

# Clean ASP benchmark output directories
asp-benchmark-clean:
    @echo "🧹 Cleaning ASP benchmark output directories..."
    rm -rf data/asp/dump/asp_test*/output
    rm -rf data/asp/dump/output
    @echo "✅ Cleanup complete!"

# Rate panoramic stitches (PySide6 inspector: N-way compare, pixel probe,
# live diffs, region annotation, keyboard-first scoring).
# Human coherence evaluator for the weekend rating pass.
#
# Usage (from Image-Toolkit root):
#   just asp-benchmark-assess
#   just asp-benchmark-assess --help
#   just asp-benchmark-assess --data-dir dump --redo
#   just asp-benchmark-assess --start-at asp_test09
#
# Dispatch lives in middleware/src/stitching/cli.
asp-benchmark-assess *ARGS:
    @echo "🎨 Rating ASP panoramic stitches (human coherence inspector)..."
    @test -x {{_IT_PY}} || (echo "error: missing {{_IT_PY}} — run: just install" && exit 1)
    @test -f {{_ASP_CLI}}/eval_dispatch.py || (echo "error: ASP missing eval_dispatch.py — check middleware/src/stitching/cli" && exit 1)
    {{_ASP_ENV}} {{_IT_PY}} \
        {{_ASP_CLI}}/eval_dispatch.py --surface inspector {{ARGS}}

# Corpus-level triage of the same evaluations in FiftyOne.
asp-triage *ARGS:
    @echo "🔎 Building the FiftyOne triage dataset for the ASP benchmark corpus..."
    {{_ASP_ENV}} {{_IT_PY}} \
        {{_ASP_CLI}}/eval_dispatch.py --surface triage {{ARGS}}

# Build/refresh the FiftyOne dataset without opening the App
asp-triage-ingest *ARGS:
    {{_ASP_ENV}} {{_IT_PY}} \
        {{_ASP_CLI}}/eval_dispatch.py --surface ingest {{ARGS}}

# Round-trip human judgment between FiftyOne and evaluations JSON.
# pull: fold App-side defect tags into the JSON (JSON stays source of truth).
# push: refresh the dataset's human fields/tags/regions from the JSON.
asp-triage-sync DIRECTION="pull" *ARGS:
    {{_ASP_ENV}} {{_IT_PY}} \
        {{_ASP_CLI}}/eval_dispatch.py --surface sync \
        --sync-direction {{DIRECTION}} {{ARGS}}

# Start a local MongoDB for FiftyOne. `fiftyone-db` ships a prebuilt mongod only
# for some distros (notably not Ubuntu 26.04 / glibc 2.43), in which case
# FiftyOne imports fine and then fails at first dataset access.
asp-triage-db:
    @echo "🍃 Starting MongoDB for FiftyOne on :27017..."
    docker start image-toolkit-fiftyone-db 2>/dev/null \
        || docker run -d --name image-toolkit-fiftyone-db -p 27017:27017 mongo:7
    @echo "✅ Now export FIFTYONE_DATABASE_URI=mongodb://localhost:27017"

# Stop that MongoDB container (data is kept in the container's volume)
asp-triage-db-stop:
    docker stop image-toolkit-fiftyone-db
