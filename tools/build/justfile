# tools/build/justfile
# Build recipes for all project components

set shell := ["bash", "-c"]
set unstable := true
set working-directory := '../..'

# Build C++ base extension (pybind11, OpenCV, Eigen3, OpenMP required).
# Replaces the former Rust/maturin build-base (Phase 7: batch/ renamed to base/).
# Also builds+installs libitk_crypto.so (the itk_crypto CMake target below) --
# a plain OpenSSL-linked C shared lib loaded via ctypes at runtime, not part
# of the pybind11 base module itself, but no longer a separate manual step.
build-base:
    @echo "Building C++ base extension..."
    PKG_CONFIG_PATH="/usr/lib/x86_64-linux-gnu/pkgconfig:$(pwd)/.pixi/envs/default/lib/pkgconfig:$PKG_CONFIG_PATH" cmake -B build/base base/ \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_PREFIX_PATH="$(pwd)/opencv/install;$(pwd)/.pixi/envs/default" \
        -DCMAKE_INSTALL_PREFIX="." \
        -DPython_EXECUTABLE="$$(which python)" \
        -DBASE_BUILD_TESTS=OFF \
        && cmake --build build/base -j$(nproc) \
        && cmake --install build/base
    @echo "base extension built and installed."

# Build native cryptography library standalone (C/OpenSSL, replaces the
# retired Kotlin JAR). Already built as part of build-base above (see
# base/CMakeLists.txt's itk_crypto target); this is a lighter-weight rebuild
# path for iterating on base/src/secret/itk_crypto.c alone.
build-crypto:
    @echo "Building native cryptography library..."
    mkdir -p build/crypto
    cc -O2 -fPIC -shared -Wall -o build/crypto/libitk_crypto.so base/src/secret/itk_crypto.c -lcrypto

# Build production application frontend
build-frontend:
    @echo "Building production application frontend..."
    npm run build

# Build the browser extension for all targets (chrome, firefox, edge, brave)
build-extension:
    @echo "Building browser extension (all targets)..."
    cd extension && npm install --no-audit --no-fund && npm run build:all
    @echo "Extension built to extension/dist/{chrome,firefox,edge,brave}."

# Build the browser extension for a single browser target
build-extension-for browser:
    @echo "Building browser extension ({{browser}})..."
    cd extension && npm install --no-audit --no-fund && npm run build:{{browser}}

# Build local OpenCV from source (bypasses system libopencv-dev requirement)
build-opencv:
    @echo "Building local OpenCV source..."
    cmake -B opencv/build opencv/ \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_SHARED_LIBS=OFF \
        -DBUILD_TESTS=OFF \
        -DBUILD_PERF_TESTS=OFF \
        -DBUILD_EXAMPLES=OFF \
        -DBUILD_opencv_apps=OFF \
        -DBUILD_opencv_python3=OFF \
        -DCMAKE_INSTALL_PREFIX=opencv/install \
        && cmake --build opencv/build -j$(nproc) \
        && cmake --install opencv/build
    @echo "OpenCV built and installed to opencv/install."

# Build everything: C++ base + native crypto + TypeScript frontend
build-all: build-base build-crypto build-frontend

# Alias for build-all
build: build-all
