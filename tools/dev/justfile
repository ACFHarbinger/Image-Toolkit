# tools/dev/justfile
# Setup, installation, and development workflow recipes

set shell := ["bash", "-c"]
set unstable := true
set working-directory := '../..'

# Sync all uv dependencies (safe on any machine — no CUDA compiler required).
# Skips --all-extras because ASP/backend[matchers] pulls in mamba-ssm, which
# compiles a CUDA extension from source and requires `nvcc` in PATH.
# Use `just dev::sync-gpu` on a machine with the full CUDA toolkit installed.
sync:
    @echo "🔄 Syncing dependencies..."
    uv sync --all-groups --all-packages

# Sync including GPU-only extras (requires nvcc / full CUDA toolkit in PATH).
# Installs ASP/backend[matchers]: mamba-ssm, sam-2, romatch, ptlflow.
sync-gpu:
    @echo "🔄 Syncing dependencies (GPU extras)..."
    @nvcc --version > /dev/null 2>&1 || (echo "❌ nvcc not found — install the CUDA toolkit first." && exit 1)
    uv sync --all-groups --all-packages --all-extras

# Complete setup (install deps + types)
setup:
    @echo "🔧 Setting up Image Toolkit..."
    npm run setup
    uv sync --all-groups --all-packages
    @echo "✅ Setup complete!"
    @echo ""
    @echo "Next steps:"
    @echo "1. Setup database: just db-setup"
    @echo "2. Configure .env: cp frontend/src-tauri/.env.example frontend/src-tauri/.env"
    @echo "3. Run app: just dev"

# Install all dependencies
install:
    @echo "📦 Installing dependencies..."
    npm run install:all

# Run Tauri app in development mode
dev:
    @echo "🚀 Starting Tauri development server..."
    npm run dev

# Run Rust type/compile checks
check:
    @echo "🔍 Running type checks..."
    npm run tauri:check

# setup + dev
quick-dev: setup dev
