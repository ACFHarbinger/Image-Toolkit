# tools/dev — environment setup and maintenance.

set shell := ["bash", "-c"]

# Set up the dev environment
setup:
    @echo "Setting up dev environment..."
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Debug -DBUILD_TESTING=ON -DBUILD_BENCHMARK=ON
    @echo "Setup complete. Run 'just test' to verify."

# Update dependencies / build
update:
    @echo "Updating build..."
    cmake --build build -j

# Run pre-commit hooks manually
pre-commit:
    pre-commit run --all-files

# Clean build artifacts
clean:
    rm -rf build
