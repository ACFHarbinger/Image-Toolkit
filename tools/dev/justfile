# tools/dev/justfile
# Setup, installation, and development workflow recipes

set shell := ["bash", "-c"]
set unstable := true
set working-directory := '../..'

# Sync all uv dependencies (safe on any machine — no CUDA compiler required).
# Skips --all-extras because ASP/backend[matchers] pulls in mamba-ssm, which
# compiles a CUDA extension from source and requires `nvcc` in PATH.
# Use `just dev::sync-gpu` on a machine with the full CUDA toolkit installed.
sync:
    @echo "🔄 Syncing dependencies..."
    uv sync --all-groups --all-packages

# Sync including GPU-only extras (requires nvcc / full CUDA toolkit in PATH).
# Installs ASP/backend[matchers]: mamba-ssm, sam-2, romatch, ptlflow.
sync-gpu:
    @echo "🔄 Syncing dependencies (GPU extras)..."
    @nvcc --version > /dev/null 2>&1 || (echo "❌ nvcc not found — install the CUDA toolkit first." && exit 1)
    uv sync --all-groups --all-packages --all-extras

# Complete setup (install deps + types)
setup:
    @echo "🔧 Setting up Image Toolkit..."
    npm run setup
    uv sync --all-groups --all-packages
    @echo "✅ Setup complete!"
    @echo ""
    @echo "Next steps:"
    @echo "1. Setup database: just db-setup"
    @echo "2. Configure .env: cp frontend/src-tauri/.env.example frontend/src-tauri/.env"
    @echo "3. Run app: just dev"

# Install all dependencies
install:
    @echo "📦 Installing dependencies..."
    npm run install:all

# Run Tauri app in development mode
dev:
    @echo "🚀 Starting Tauri development server..."
    npm run dev

# Run Rust type/compile checks
check:
    @echo "🔍 Running type checks..."
    npm run tauri:check

# setup + dev
quick-dev: setup dev

# --- Development Tool (dev/tool, the devtool CLI/TUI/web host) ---
#
# Canonical invocation is `python dev/` (running a directory adds it to
# sys.path[0], so `tool` resolves with no PYTHONPATH needed) -- see
# dev/README.md and docs/moon/roadmaps/development_tool.md.

# Workspace chooser / any devtool verb (plugins, list, analyze, export, ...)
devtool *ARGS:
    @echo "🛠️  Development Tool..."
    source .venv/bin/activate && python dev/ {{ARGS}}

# Launch the Development Tool TUI (Perfetto-style static trace/crash views)
devtool-tui *ARGS:
    @echo "🛠️  Launching Development Tool TUI..."
    source .venv/bin/activate && python dev/ tui {{ARGS}}

# Launch the Development Tool live watch (btop-style RSS/thread/span monitor)
devtool-watch *ARGS:
    @echo "🛠️  Launching Development Tool live watch..."
    source .venv/bin/activate && python dev/ watch {{ARGS}}

# Launch the Development Tool local web viewer (pixels: benchmark A/B, plots)
devtool-web *ARGS:
    @echo "🛠️  Launching Development Tool web viewer..."
    source .venv/bin/activate && python dev/ web {{ARGS}}

# Run the Development Tool MCP stdio server (agent surface)
devtool-mcp *ARGS:
    @echo "🛠️  Starting Development Tool MCP server..."
    source .venv/bin/activate && python dev/ mcp {{ARGS}}

# Launch the Development Tool Tauri host window (v2 #414). `just devtool`
# stays the Python CLI (unchanged); this recipe opens the Tauri app in
# dev/app. Requires the tauri-cli: `cargo install tauri-cli` (source-built
# first Linux release, lock #1). No AppImage/.deb/Flatpak yet (D61 deferred).
#
# WEBKIT_DISABLE_DMABUF_RENDERER=1: WebKitGTK's DMA-BUF renderer crashes
# with "WebKit encountered an internal error" on NVIDIA + Wayland (the
# proprietary driver doesn't support the DMA-BUF path WebKitGTK assumes).
# GDK_BACKEND=x11: with a broken/mismatched NVIDIA EGL stack (e.g. a
# post-boot driver upgrade leaving the kernel module out of sync with the
# userspace libs), WebKitGTK still cannot create an EGL context on native
# Wayland and the window stays blank white; running under XWayland routes
# the GL through the working GLX/EGL-X11 path and the UI renders.
# LD_LIBRARY_PATH cleared: a leaked snap LD_LIBRARY_PATH (common when the
# launching terminal is itself snap-confined) shadows system libpthread
# with a snap core20 copy, crashing WebKitNetworkProcess with a symbol
# lookup error. See docs/TROUBLESHOOTING.md.
devtool-app *ARGS:
    @echo "🛠️  Launching Development Tool app (Tauri host)..."
    cd dev/app/src-tauri && GDK_BACKEND=x11 WEBKIT_DISABLE_DMABUF_RENDERER=1 LD_LIBRARY_PATH= cargo tauri dev {{ARGS}}
