# tools/gui/justfile
# Desktop GUI application recipes

set shell := ["bash", "-c"]
set unstable := true
set working-directory := '../..'

# Start the Desktop GUI Application
gui args="":
    @echo "🐍 Starting Image-Toolkit Desktop App..."
    source .venv/bin/activate && python main.py gui {{args}}

# Start the Desktop GUI with ComfyUI-Manager integration enabled
gui-manager:
    @echo "🛠️ Starting Image-Toolkit with Manager integration..."
    source .venv/bin/activate && python main.py gui --enable-manager

# --- Anime-Stitch-Pipeline (standalone, not the full Image-Toolkit app) ---

# Launch just the ASP stitch tab in its own PySide6 window
asp-gui:
    @echo "🐍 Starting Anime-Stitch-Pipeline Desktop App..."
    source .venv/bin/activate && cd submodules/Anime-Stitch-Pipeline/gui && python launch.py

# Launch the ASP Tauri cross-platform UI (scaffold — see submodules/Anime-Stitch-Pipeline/frontend/README.md)
asp-web:
    @echo "🦀 Starting Anime-Stitch-Pipeline Tauri App..."
    cd submodules/Anime-Stitch-Pipeline/frontend && npm run tauri:dev

# --- Cel-Shaded-Generator (standalone, not the full Image-Toolkit app) ---

# Launch just the Manga Colorization/Animation/Puppeteering tabs in their own PySide6 window
manga-gui:
    @echo "🐍 Starting Cel-Shaded-Generator Desktop App..."
    source .venv/bin/activate && cd submodules/Cel-Shaded-Generator/gui && python launch.py

# Launch the Manga Tauri cross-platform UI (scaffold — see submodules/Cel-Shaded-Generator/frontend/README.md)
manga-web:
    @echo "🦀 Starting Cel-Shaded-Generator Tauri App..."
    cd submodules/Cel-Shaded-Generator/frontend && npm run tauri:dev
