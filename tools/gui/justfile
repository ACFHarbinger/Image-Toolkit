# tools/gui/justfile
# Desktop GUI application recipes

set shell := ["bash", "-c"]
set unstable := true
set working-directory := '../..'

# Start the Desktop GUI Application
gui args="":
    @echo "🐍 Starting Image-Toolkit Desktop App..."
    source .venv/bin/activate && python backend/main.py gui {{args}}

# Start the Desktop GUI with ComfyUI-Manager integration enabled
gui-manager:
    @echo "🛠️ Starting Image-Toolkit with Manager integration..."
    source .venv/bin/activate && python backend/main.py gui --enable-manager

# --- ASP (standalone, not the full Image-Toolkit app) ---

# Launch just the ASP stitch tab in its own PySide6 window
asp-gui:
    @echo "🐍 Starting ASP Desktop App..."
    source .venv/bin/activate && cd submodules/ASP/gui && python launch.py

# Launch the ASP Tauri cross-platform UI (scaffold — see submodules/ASP/frontend/README.md)
asp-web:
    @echo "🦀 Starting ASP Tauri App..."
    cd submodules/ASP/frontend && npm run tauri:dev

# --- CSG (standalone, not the full Image-Toolkit app) ---

# Launch just the Manga Colorization/Animation/Puppeteering tabs in their own PySide6 window
manga-gui:
    @echo "🐍 Starting CSG Desktop App..."
    source .venv/bin/activate && cd submodules/CSG/gui && python launch.py

# Launch the Manga Tauri cross-platform UI (scaffold — see submodules/CSG/frontend/README.md)
manga-web:
    @echo "🦀 Starting CSG Tauri App..."
    cd submodules/CSG/frontend && npm run tauri:dev
