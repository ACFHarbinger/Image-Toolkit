# tools/gui/justfile
# Desktop GUI application recipes

set shell := ["bash", "-c"]
set unstable := true
set working-directory := '../..'

# Start the Desktop GUI Application
gui args="":
    @echo "🐍 Starting Image-Toolkit Desktop App..."
    source .venv/bin/activate && python middleware/main.py gui {{args}}

# Start the Desktop GUI with ComfyUI-Manager integration enabled
gui-manager:
    @echo "🛠️ Starting Image-Toolkit with Manager integration..."
    source .venv/bin/activate && python middleware/main.py gui --enable-manager

# --- ASP & CSG (absorbed into main Tauri application, #1039) ---

# Standalone ASP GUI (absorbed into Image-Toolkit; use npm run dev)
asp-gui:
    @echo "asp-gui is absorbed into the main application. Run: npm run dev"

# Launch the ASP stitch view in the main application
asp-web:
    @echo "asp-web is absorbed into the main application. Run: npm run dev"

# Standalone CSG GUI (absorbed into Image-Toolkit; use npm run dev)
manga-gui:
    @echo "manga-gui is absorbed into the main application. Run: npm run dev"

# Launch the Manga views in the main application
manga-web:
    @echo "manga-web is absorbed into the main application. Run: npm run dev"
