# tools/repository/justfile
# Commands that integrate with external repositories (ComfyUI, etc.)

set shell := ["bash", "-c"]
set unstable := true
set working-directory := '../..'

krita_root := "submodules/CSG"

# Start ComfyUI headlessly (without the main desktop app)
comfyui args="":
    @echo "🎨 Starting ComfyUI server..."
    source .venv/bin/activate && python -m backend.controllers.hydra_dispatch command=comfyui {{args}}

# Stop any running ComfyUI instances
comfyui-stop:
    @echo "🛑 Stopping ComfyUI server..."
    -pkill -f "ComfyUI/main.py"

# Install the CSG Krita plugin (close Krita first)
krita-install:
    @echo "🎨 Installing CSG Krita plugin..."
    cd {{krita_root}} && uv run python integrations/krita/install.py install --engine .venv/bin/cel-shaded-generator-engine

# Uninstall the CSG Krita plugin (close Krita first)
krita-uninstall:
    @echo "🗑️  Uninstalling CSG Krita plugin..."
    cd {{krita_root}} && uv run python integrations/krita/install.py uninstall

# Reinstall the plugin — use after pulling submodule updates (close Krita first)
krita-reinstall: krita-uninstall krita-install
    @echo "✅ CSG Krita plugin reinstalled."