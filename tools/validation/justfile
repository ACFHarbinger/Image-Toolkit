# tools/validation/justfile
# Codebase validation, static analysis, and documentation quality recipes

set shell := ["bash", "-c"]
set unstable := true
set working-directory := '../..'

# Count lines of code and comments (--group-by-dir N to aggregate by directory depth)
count-loc group_by="0":
    uv run python middleware/validation/count_loc.py middleware/src --group-by-dir {{group_by}}

# Enforce maximum lines of code per file (exits non-zero on violation)
check-loc max="500" exceptions="docs/loc_exceptions.txt":
    uv run python middleware/validation/count_loc.py middleware/src gui/src --max-code-lines {{max}} --exceptions-file {{exceptions}} --fail-over

# Enforce additive-only schema migrations while a PySide6 row lives (W0-20)
check-migration-additive base="":
    uv run python middleware/validation/check_migration_additive.py {{if base != "" { "--base " + base } else { "" }}}

# Validate the migration ledger against the #869 catalog and the tree (W0-18)
check-migration-ledger:
    PYTHONPATH=. uv run python middleware/validation/check_migration_ledger.py

# Fail if docs/migration/parity.md drifts from migration/features.toml (W0-18)
check-parity-doc:
    PYTHONPATH=. uv run python migration/generate_parity.py --check

# Generate Markdown LoC report
loc-report output="build/gen/loc_report.md" limit="50":
    uv run python middleware/validation/count_loc.py middleware/src gui/src --sort code --limit {{limit}} --markdown-out {{output}}

# Tree view of lines of code and comments
tree-loc:
    uv run python middleware/validation/tree_loc.py middleware/src

# Check docstring coverage
check-docs:
    uv run python middleware/docs/check_docstrings.py middleware/src
    uv run python middleware/docs/check_docstrings.py gui/src

# Check Google style docstrings
check-google-docs:
    uv run python middleware/docs/check_google_style.py middleware/src

# Check for multiple classes in one file
check-multi-classes:
    uv run python middleware/validation/check_multi_classes.py middleware/src

# Find all relative imports with optional stats or exclude_same_package=true
check-relative-imports exclude_same_package="":
    uv run python middleware/validation/check_relative_imports.py middleware/src \
        --stats \
        {{if exclude_same_package != "" { "--exclude-same-package" } else { "" }}}

# Check for nested imports
check-nested-imports:
    uv run python middleware/validation/check_nested_imports.py middleware/src --ignore_factories

# Check gui package-initializer import boundaries: no star imports in
# gui/src/**/__init__.py, no eager submodule imports in
# gui/src/windows/__init__.py (issue #530, D9 — fails CI, blocks merge)
check-init-boundaries:
    uv run python middleware/validation/check_init_boundaries.py

# Check for nested imports with a per-package summary table
check-nested-imports-stats:
    uv run python middleware/validation/check_nested_imports.py middleware/src --ignore_factories --stats

# Detect circular import chains using Tarjan's SCC algorithm
check-circular-imports html="":
    uv run python middleware/validation/check_circular_imports.py middleware/src \
        {{if html != "" { "--html " + html } else { "" }}}

# Check that all concrete classes fully implement their ABC/Protocol interface contracts
check-interface-compliance:
    uv run python middleware/validation/check_interface_compliance.py middleware/src

# Measure type annotation coverage per file (worst-coverage files shown first)
check-type-coverage sort="coverage" limit="40":
    uv run python middleware/validation/check_type_coverage.py middleware/src \
        --sort {{sort}} --limit {{limit}}

# Generate interactive module-level import graph covering middleware/src + gui/src
# together (so cross-boundary edges/violations are visible), opens in browser
module-graph html="build/gen/module_graph.html" depth="10":
    uv run python middleware/validation/visualize_module_graph.py ./middleware/src ./gui/src \
        --exclude .venv venv node_modules \
        --html {{html}} --depth {{depth}}

# Create a graph with exported and imported dependencies (function, classes, etc.)
dependency-graph target_file="middleware/controllers/backend_dispatch.py" target_name="dispatch_command":
    uv run python middleware/validation/trace_dependencies.py middleware/src {{target_file}} {{target_name}}

# Check for embedded languages in the Python source code
check-embedded-languages:
    uv run python middleware/validation/check_embedded_languages.py middleware/src

# Check for unused imports in the Python source code
check-unused-imports:
    uv run python middleware/validation/check_unused_imports.py middleware/src --ignore_factories

# Check uppercase constant declarations across backend and gui directories
check-constants:
    uv run python middleware/validation/constant_checker.py
